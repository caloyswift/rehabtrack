NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Local demo accounts only; the buttons only appear in development.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
NEXT_PUBLIC_DEMO_PATIENT_EMAIL=demo.patient@example.com
NEXT_PUBLIC_DEMO_PATIENT_PASSWORD=DemoPatient!2026
NEXT_PUBLIC_DEMO_THERAPIST_EMAIL=demo.therapist@example.com
NEXT_PUBLIC_DEMO_THERAPIST_PASSWORD=DemoTherapist!2026

# Required only to run `npm run demo:seed`. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
